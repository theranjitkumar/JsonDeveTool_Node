<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} - JSON Dev Tool</title>
    <meta name="description" content="{{description}}">
    <meta name="keywords" content="{{keywords}}">

    <!-- ==== Open Graph tags === -->
    <meta property="og:type" content="{{metaOgType}}" />
    <meta property="og:title" content="{{metaOgTitle}} - JSON Dev Tool" />
    <meta property="og:description" content="{{metaOgDescription}}" />
    <meta property="og:image" content="{{metaOgImage}}" />
    <!-- === Open Graph tags end === -->

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/img/logo/favicon.ico">
    <link rel="apple-touch-icon" href="/img/logo/apple-touch-icon.png">

    <!-- Libs -->
    <link rel="stylesheet" href="/css/bootstrap.css">
    {{!--
    <link rel="stylesheet" href="/css/jsoneditor.min.css"> --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jsoneditor/10.4.1/jsoneditor.css">
    <link rel='stylesheet' href='/css/style.css'>

    <script src="/js/jsoneditor.min.js"></script>
</head>

<body class="d-flex flex-column h-100">
    <div id="jsoneditor" data-json='{{{ json }}}'></div>
    <div id="error" class="error"></div>

    <script src="/js/script.js"></script>
</body>

</html>